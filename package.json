{
  "name": "pokemon-mcp",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc",
    "smoke": "tsx src/smoke-test.ts",
    "preview": "npm run build:web && echo 'Abre http://localhost:8787/preview (con npm run dev:http)'"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
